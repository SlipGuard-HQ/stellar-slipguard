# Solver bot configuration. Copy to .env and fill in.
# Never commit a real .env or a real SOLVER_SECRET_KEY.

# Either set a network preset ...
STELLAR_NETWORK=testnet
# ... or set the Stellar RPC endpoint and passphrase explicitly.
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015

ALLOW_HTTP=false

# Deployed SlipGuardRouter Soroban contract id (C...).
ROUTER_CONTRACT_ID=

# Solver signing key: a Stellar secret seed (S...). Keep this in a secret
# manager, not in git.
SOLVER_SECRET_KEY=

# Optional HTTP endpoint returning a JSON array of signed intents. Each entry is
# an intent, or an object with `intent` and a base64 `traderAuthEntry`.
INTENT_FEED_URL=

# Poll interval in milliseconds. Stellar closes a ledger roughly every 5s.
POLL_INTERVAL_MS=5000

# First ledger to scan for router events. Leave blank to start from the tip.
START_LEDGER=

# Minimum acceptable net profit, in buy-token units.
MIN_PROFIT=0

# Estimated fill transaction cost, in buy-token units: the 100-stroop base fee
# plus the Soroban resource fee for the CPU and I/O the fill uses.
TX_COST=0

# Maximum transaction fee in stroops.
MAX_FEE_STROOPS=100000

# How long to wait for ledger inclusion, in milliseconds.
TX_TIMEOUT_MS=60000

# USD price per Stellar contract id, used to value fills. JSON object.
TOKEN_PRICES={}

# debug | info | warn | error
LOG_LEVEL=info

# When true the bot evaluates and logs but never submits.
DRY_RUN=true
